# Copy to .env.local for local dev, and set the same in Vercel's project settings.
# Leave everything blank to keep running against the local JSON files (current dev mode).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY — never expose to the client
# Used only by the migration script; the pooled connection string (port 6543):
SUPABASE_DB_URL=postgresql://postgres:...@...pooler.supabase.com:6543/postgres

# --- Access control (enforced in app middleware, on top of Supabase Auth) ---
AUTH_ALLOWLIST=you@example.com,family@example.com   # emails allowed to sign in at all
AUTH_ADMINS=you@example.com                         # subset allowed to edit / delete

# --- App ---
NEXT_PUBLIC_SITE_URL=https://vivarium.example.com

# --- Cloudflare R2 (image storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=            # server/script only — keep private
R2_BUCKET=vivarium
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Anthropic (ingest/enrichment pipeline only; the app never calls the API) ---
# ANTHROPIC_API_KEY=sk-ant-...

# Note: the old Neon DATABASE_URL is superseded by Supabase above.
