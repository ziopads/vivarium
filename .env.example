# Copy to .env.local for local dev, and set the same in Vercel's project settings.
# Leave everything blank to keep running against the local JSON files (current dev mode).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY — never expose to the client
# Used only by the migration script; the pooled connection string (port 6543):
SUPABASE_DB_URL=postgresql://postgres:...@...pooler.supabase.com:6543/postgres

# --- Access control (enforced in app middleware, on top of Supabase Auth) ---
AUTH_ALLOWLIST=you@example.com,family@example.com   # emails allowed to sign in at all
AUTH_ADMINS=you@example.com                         # subset allowed to edit / delete

# --- App ---
NEXT_PUBLIC_SITE_URL=https://vivarium.example.com

# --- Instance switching (local dev) ---
# Point one deployment/checkout at a different dataset without touching the code.
# UNSET = current behaviour (Supabase if configured, else data/items.json).
# Setting LOCAL_DATA_FILE *forces* local mode even when Supabase is configured —
# naming a dataset is an unambiguous statement about which one you want.
# LOCAL_DATA_FILE=data/items.tamplin.json
# NEXT_PUBLIC_LOCAL_IMAGE_DIR wins over R2 for the same reason (so a dev instance
# with the library's R2 creds doesn't fetch the CR's images from the wrong bucket):
# NEXT_PUBLIC_LOCAL_IMAGE_DIR=items-tamplin
# VOCAB_FILE is derived from LOCAL_DATA_FILE when omitted (items.x.json -> vocab.x.json):
# VOCAB_FILE=data/vocab.tamplin.json

# --- Instance identity + theme (chrome, nav, metadata, palette) ---
# Selects a per-instance config module (lib/instance.ts): wordmark, nav links,
# footer, page metadata, and the data-theme that drives the colour + font tokens
# in globals.css. Build-time inlined (NEXT_PUBLIC_), so set it on the relevant
# Vercel project and redeploy to change it. UNSET = 'library' (the Vivarium /
# gaffcutter look — the library needs no new env). Set to 'tamplin' for the
# Valerie Tamplin catalogue (white, monochrome, Instrument Sans, site chrome).
# NEXT_PUBLIC_INSTANCE=tamplin

# --- Public gate ("velvet rope" — restricted public access) ---
# One shared password admits a visitor to the PUBLIC (field-stripped) view.
# Admin rights are separate and unchanged (AUTH_ADMINS email, layered on top).
# UNSET or "0" = NO gate = current vivarium.gaffcutter.com behaviour.
# Set these per-deployment in Vercel, NOT in your working .env.local (you don't
# want to type a password to see your own dev catalogue).
# PUBLIC_GATE_ENABLED=1
# PUBLIC_GATE_PASSWORD=change-me
# PUBLIC_GATE_SECRET=            # optional HMAC secret; falls back to the password.
                                # Rotating either logs every visitor out.

# --- Cloudflare R2 (image storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=            # server/script only — keep private
R2_BUCKET=vivarium
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- Anthropic (ingest/enrichment pipeline only; the app never calls the API) ---
# ANTHROPIC_API_KEY=sk-ant-...

# Note: the old Neon DATABASE_URL is superseded by Supabase above.
